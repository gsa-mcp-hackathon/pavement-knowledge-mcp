{
  "mcpServers": {
    "pavement_knowledge": {
      "command": "C:/pavement-knowledge/.venv/Scripts/python.exe",
      "args": [
        "-I",
        "-B",
        "C:/pavement-knowledge/mcp_server/launch.py"
      ],
      "env": {
        "PAVEMENT_MCP_CORPUS_ROOT": "C:/pavement-runtime",
        "HF_HOME": "C:/pavement-runtime/model-cache",
        "HF_HUB_CACHE": "C:/pavement-runtime/model-cache/hub",
        "HF_HUB_DISABLE_TELEMETRY": "1",
        "HF_HUB_DISABLE_IMPLICIT_TOKEN": "1",
        "ANONYMIZED_TELEMETRY": "False"
      }
    }
  }
}
